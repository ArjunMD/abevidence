# ---- Python ----
__pycache__/
*.py[cod]
*.so
*.egg-info/

# ---- Virtualenv ----
.venv/
venv/
ENV/

# ---- Streamlit ----
# Never commit secrets.
.streamlit/secrets.toml
.streamlit/secrets.*

# ---- OS / editor / agent ----
.DS_Store
Thumbs.db
.idea/
.claude/

# ---- Word scratch ----
# Word writes a ~$ lock file next to any open document, and edits leave .bak
# copies behind. Neither belongs in history.
~$*
*.bak
*.bak[0-9]

# ---- Local scratch ----
Versions/
